# Shared disk-build bundle and explicit installation list for existing systems.
# Full custom bundle; Aurora defaults are excluded from disk preparation.
# Simple brew/flatpak declarations only; parsed by controlthings-tools.
brew "bat"
brew "bettercap"
brew "binwalk"
brew "btop"
brew "difftastic"
brew "doggo"
brew "duf"
brew "dust"
brew "ent"
brew "eza"
brew "fd"
brew "git-delta"
brew "gping"
brew "hackrf"
brew "libbladerf"
brew "librtlsdr"
brew "lynis"
brew "macchina"
brew "moor"
brew "nmap"
brew "procs"
brew "ripgrep"
brew "rtl_433"
brew "sd"
brew "sqlmap"
brew "starship"
brew "tealdeer"
brew "xh"
brew "zeek"
brew "zoxide"

flatpak "com.github.tchx84.Flatseal"
flatpak "dk.gqrx.gqrx"
flatpak "io.missioncenter.MissionCenter"
flatpak "io.github.DenysMb.Kontainer"
flatpak "io.github.flattool.Warehouse"
flatpak "io.github.kolunmi.Bazaar"
flatpak "md.obsidian.Obsidian"
flatpak "net.werwolv.ImHex"
flatpak "org.fkoehler.KTailctl"
flatpak "org.gnome.Firmware"
flatpak "org.kde.gwenview"
flatpak "org.kde.kcalc"
flatpak "org.kde.kclock"
flatpak "org.kde.okteta"
flatpak "org.kde.okular"
# Flathub does not publish ZAP for ARM64; omit it on that architecture.
flatpak "org.zaproxy.ZAP" # arch=x86_64
