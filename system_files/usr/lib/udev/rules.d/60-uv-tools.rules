# GreatFET 2026.0.0's packaged uaccess rules, restricted to USB devices.
# https://github.com/greatscottgadgets/greatfet/tree/da49f6b8e3b4d1a490b793df1b50e7f8152ae71f/host/greatfet/assets
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="60e6", SYMLINK+="greatfet-one%k", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc9", ATTR{idProduct}=="000c", SYMLINK+="nxp-dfu-%k", TAG+="uaccess"
# RfCat device IDs from upstream etc/udev/rules.d/20-rfcat.rules.
# Active local sessions receive access; remote sessions can use the dialout group.
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="4715", MODE="0660", GROUP="dialout", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6047|6048|605b|ecc1", MODE="0660", GROUP="dialout", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6049|604a|605c|ecc0", MODE="0660", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
