# Generic ISO environment based on the upstream Fedora Anaconda example:
# https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
# This environment is separate from the disk-only ControlThings payload, whose
# /var already contains the prepared tools. It does not publish a channel image.
FROM quay.io/fedora/fedora-bootc:44@sha256:2cdd9f75bdcfb2c0cbbd3c86942d3c1aef8ec0bd842e3fcdf884995887681f2e

ARG PAYLOAD_REF
ARG TARGET_ARCH=amd64
# ARM64 boots via UEFI and has no x86 BIOS modules.
RUN case "$TARGET_ARCH" in \
      amd64) set -- grub2-efi-x64-cdboot grub2-pc-modules ;; \
      arm64) set -- grub2-efi-aa64-cdboot ;; \
      *) echo "Unsupported installer architecture: $TARGET_ARCH" >&2; exit 1 ;; \
    esac && \
    dnf install -y --setopt='*.countme=false' \
    anaconda anaconda-install-img-deps anaconda-dracut \
    dracut-config-generic dracut-network net-tools \
    "$@" grub2-tools-extra \
    plymouth default-fonts-core-sans default-fonts-other-sans \
    google-noto-sans-cjk-fonts xorrisofs squashfs-tools isomd5sum jq \
    && dnf clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Install the embedded, pinned local payload; future updates follow its channel.
# PAYLOAD_REF is generated from validated channel input by build-disk.py.
RUN test -n "$PAYLOAD_REF" && \
    printf 'bootc --source-imgref containers-storage:%s --target-imgref %s\n' \
    "$PAYLOAD_REF" "$PAYLOAD_REF" > /usr/share/anaconda/interactive-defaults.ks

# Prepare the live installer session, following the upstream generic ISO setup.
RUN echo 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' >> /etc/passwd && \
    echo 'install::14438:0:99999:7:::' >> /etc/shadow && passwd -d root && \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -sf /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

COPY anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
COPY allowroot.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY allowroot.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf

RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -er '[.[] | select(.has_kernel == true)] | if length == 1 then .[0].version else error("expected one kernel") end') && \
    DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
    --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "$kernel"
